---
layout: base
title: Home
---

{% block content %}
  <h1>Welcome to Mercor Affiliate Blog</h1>
  <p>Explore remote career insights across our categories.</p>

  <h2>Categories</h2>
  <ul>
    {% for cat in collections %}
      <li><a href="/categories/{{ cat }}/">{{ cat }}</a></li>
    {% endfor %}
  </ul>

  <h2>Latest Posts</h2>
  <ul>
    {% for post in collections.all | reverse | slice(0,5) %}
      <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
    {% endfor %}
  </ul>
{% endblock %}
