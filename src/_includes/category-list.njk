<section class="categories">
  <h2>Browse Categories</h2>
  <ul>
    {% set categories = [
      "creative","data","engineering","finance","language",
      "law","medicine","misc","operations","sciences","tech"
    ] %}

    {% for cat in categories %}
      <li>
        <a href="/categories/{{ cat }}/">
          {{ cat | capitalize }}
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
