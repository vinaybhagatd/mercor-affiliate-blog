---
layout: category.njk
pagination:
  data: collections.categories
  size: 1
  alias: category
permalink: "categories/{{ category }}/index.html"
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ category | capitalize }} - Mercor Affiliate Blog</title>
  <link rel="stylesheet" href="/assets/styles/main.css">
</head>
<body>
  <header>
    <h1><a href="/">Mercor Affiliate Blog System</a></h1>
  </header>

  <main>
    <section class="category-page">
      <header class="category-header">
        <h1>{{ category | capitalize }}</h1>
        <p>Explore affiliate blog posts in the {{ category | capitalize }} category.</p>
      </header>

      <ul class="category-list">
        {% for post in collections[category] %}
          <li>
            <a href="{{ post.url }}">{{ post.data.title }}</a>
            <span class="post-date">{{ post.date | date("dd LLL yyyy") }}</span>
          </li>
        {% endfor %}
      </ul>
    </section>
  </main>

  <footer>
    <p>&copy; Mercor Affiliate Blog System</p>
  </footer>
</body>
</html>
