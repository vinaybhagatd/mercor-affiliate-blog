<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }} - Mercor Affiliate Blog</title>
  <link rel="stylesheet" href="/assets/styles/main.css">
</head>
<body>
  <header>
    <h1><a href="/">Mercor Affiliate Blog System</a></h1>
  </header>

  <main>
    <article class="post">
      <header class="post-header">
        <h1>{{ title }}</h1>
        {% if date %}
          <p class="post-date">{{ date | date("dd LLL yyyy") }}</p>
        {% endif %}
      </header>

      <section class="post-content">
        {{ content | safe }}
      </section>

      {% if tags %}
        <footer class="post-tags">
          <p>Filed under:
            {% for tag in tags %}
              <a href="/categories/{{ tag }}/">{{ tag }}</a>{% if not loop.last %}, {% endif %}
            {% endfor %}
          </p>
        </footer>
      {% endif %}
    </article>
  </main>

  <footer>
    <p>&copy; Mercor Affiliate Blog System</p>
  </footer>
</body>
</html>
