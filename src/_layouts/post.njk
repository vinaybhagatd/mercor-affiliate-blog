{% extends "base.njk" %}

{% block content %}
<article class="post">
  <header>
    <h1>{{ title }}</h1>
    <p class="description">{{ description }}</p>
  </header>

  <section class="affiliate">
    <a href="{{ affiliate }}" class="cta-link">Explore via Affiliate</a>
  </section>

  <section class="why-this-matters">
    <h2>🌟 Why This Matters</h2>
    {{ content | safe }}
  </section>

  <footer>
    <p class="keywords">Keywords: {{ keywords }}</p>
  </footer>
</article>
{% endblock %}
