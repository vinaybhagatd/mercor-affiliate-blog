{% extends "base.njk" %}

{% block content %}
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{{ title }}</h1>
      {% if date %}
        <p class="post-date">{{ date | date("MMM dd, yyyy") }}</p>
      {% endif %}
      {% if category %}
        <p class="post-category">Category: {{ category }}</p>
      {% endif %}
    </header>

    <section class="post-body">
      {{ content | safe }}
    </section>

    <footer class="post-footer">
      {% if tags %}
        <p class="post-tags">Tags: {{ tags | join(", ") }}</p>
      {% endif %}
    </footer>
  </article>
{% endblock %}
