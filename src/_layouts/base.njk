<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title or "Mercor Affiliate Blog" }}</title>
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>
  <header id="site-header">
    <h1 class="site-title"><a href="/">Mercor Affiliate Blog</a></h1>
    <nav id="site-nav" class="nav">
      <ul class="nav-list">
        {% for cat, posts in collections.categories %}
          <li class="nav-item">
            <a class="nav-link" href="/categories/{{ cat }}/">{{ cat }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </header>

  <main id="site-main">
    {% block body %}{% endblock %}
  </main>

  <footer id="site-footer">
    <p>&copy; {{ site.year }} Mercor Affiliate Blog System</p>
  </footer>
</body>
</html>



