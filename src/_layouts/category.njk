<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ category | capitalize }} - Mercor Affiliate Blog</title>
  <link rel="stylesheet" href="/assets/styles/main.css">
</head>
<body>
  <header>
    <h1>Mercor Affiliate Blog</h1>
    <nav>
      <ul>
        {% set allowedCategories = [
          "creative","data","engineering","finance","language",
          "law","medicine","misc","operations","sciences","tech"
        ] %}
        {% for cat in allowedCategories %}
          <li><a href="/categories/{{ cat }}/">{{ cat | capitalize }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </header>

  <main>
    <h2>{{ category | capitalize }}</h2>
    <ul>
      {% for post in collections[category] %}
        <li>
          <a href="{{ post.url }}">{{ post.data.title }}</a>
          {% if post.date %}
            <span class="post-date">({{ post.date | date("MMMM dd, yyyy") }})</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </main>

  <footer>
    <p>&copy; {{ "now" | date("yyyy") }} Mercor Affiliate Blog System</p>
  </footer>
</body>
</html>
