# Ignore build output
_site/

# Ignore validation reports
QAReport.txt

# Ignore OS/system files
.DS_Store
Thumbs.db

# Ignore logs and temp files
*.log
*.tmp

# Ignore node_modules if using Eleventy/Jekyll plugins
node_modules/

# Ignore PowerShell history
*.pshistory

# Ignore editor/IDE settings
.vscode/
.idea/

# Keep source files tracked
!blogs/
!*.ps1
!blogData.csv
!blogData.json
!assets/
!_includes/
!_layouts/
