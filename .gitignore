# =========================
# Node.js dependencies
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# Eleventy build output
# =========================
_site/
.cache/
.tmp/

# =========================
# Build artifacts
# =========================
build/
dist/
build.log
createblog.log
deploy.yml

# =========================
# PowerShell ScriptAnalyzer / Formatter reports
# =========================
PreCommitReport.txt
WarningsReport.txt
ScriptAnalyzerReport_*.txt
FormatterReport_*.txt
QAReport.txt
BulkFixReport.txt
UnicodeMasterReport.log

# =========================
# Diagnostic logs
# =========================
diagnostics.log
diagnostics_log_*.txt
loader.log
mercordebug.log
orchestrator.log
pipeline-logs/
hermes-logs/

# =========================
# General hygiene reports
# =========================
*.err
*.out
*.tmp
*.bak
*.swp
*.swo
*.removed.log

# =========================
# Logs
# =========================
*.log
logs/
reports/*.log
outputs/*.log

# =========================
# Editor / IDE artifacts
# =========================
.vscode/
.idea/
*.iml
*.sln
*.user
*.vs/
*.code-workspace

# =========================
# OS-specific junk
# =========================
.DS_Store
Thumbs.db

# =========================
# PowerShell scripts
# =========================
# Ignore all .ps1 by default
*.ps1

# Whitelist critical automation scripts
!FixFrontMatter.ps1
!QAValidator.ps1
!MABSValidator.ps1
!Create-Release.ps1
!Cleanup-All.ps1
!Cleanup-Blogs.ps1
!Cleanup-Repo.ps1
!RunAll.ps1
!SelfHeal.ps1
!BulkFix-Posts.ps1
!ReleaseAudit.ps1
!DeployAll.ps1

# =========================
# Catch-all for generated artifacts
# =========================
*_Report.txt
*.notes.txt
*.out.txt
*.diff.txt
*.summary.txt
*.analysis.txt
outputs/*.notes.txt
outputs/*.out.txt
outputs/*.diff.txt
outputs/*.summary.txt
outputs/*.analysis.txt

# =========================
# Future generated directories
# =========================
outputs/
reports/
artifacts/
temp/
cache/
logs/

# Allow whitelisted automation scripts inside these dirs
!outputs/*.ps1
!reports/*.ps1
!artifacts/*.ps1
