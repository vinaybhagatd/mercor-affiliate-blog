function Log {
    param([string]$text)
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    "$timestamp - $text" | Out-File -FilePath $LogFile -Append
}

function Run-Orchestrator {
    try {
        Log "Running Orchestrator at $OrchestratorPath..."
        & $OrchestratorPath
        return $true
    }
    catch {
        Log "Error running Orchestrator: $_"
        return $false
    }
}

