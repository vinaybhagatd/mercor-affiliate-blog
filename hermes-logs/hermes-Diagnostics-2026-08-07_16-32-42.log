To address the known issues and improve the script's functionality, apply the following fixes:

```powershell
# Diagnostics.ps1

param(
	[switch]$ExecuteMode,   # Run Hermesï¿½?Ts plan
	[switch]$DryRunMode,    # Preview Hermesï¿½?Ts plan without executing
	[int]$MaxRetries = 3,   # maximum number of attempts
	[int]$BackoffSeconds = 5 # initial wait time between retries
)

$headers = @{ "Content-Type" = "application/json" }
$projectPath   = "C:\Users\LMTest\promotional\mercor-affiliate-blog"
$logFile       = Join-Path $projectPath "diagnostics.log"
$buildLogFile  = Join-Path $projectPath "build.log"

function Log($text) {
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    "$timestamp - $text" | Out-File -FilePath $logFile -Append
}

function ShowBanner($mode) {
    Write-Output "`n=============================="
    Write-Output "Diagnostics running in $mode MODE"
    Write-Output "==============================`n"
    Log "Diagnostics running in $mode MODE"
}

# === Retry wrapper for commands ===
function Invoke-WithRetry {
    param(
        [scriptblock]$Action,
        [string]$Description,
        [int]$maxRetries,
        [int]$backoff
    )

    for ($i=1; $i -le $maxRetries; $i++) {
        try {
            Log "Attempt $i: $Description"
            & $Action
            return $true
        }
        catch {
            Log "Error during $Description attempt $i: $($_.Exception.Message)"
            if ($i -lt $maxRetries) {
                Log "Retrying after $backoff seconds..."
                Start-Sleep -Seconds $backoff
                $backoff *= 2   # exponential backoff
            }
        }
    }
    return $false
}

try {
    # Step 0: Run Eleventy build with retry/backoff
    $buildSuccess = Invoke-WithRetry -Action {
        Push-Location $projectPath
        npm run build > "$buildLogFile" 2>&1
        Pop-Location
        Log "Eleventy build complete. Log saved to $buildLogFile"
    } -Description "Eleventy build" -maxRetries $MaxRetries -backoff $BackoffSeconds
    
    # Ensure the build success check properly handles spaces in paths.
    if (-not $buildSuccess) {
        Write-Error "Build failed after $MaxRetries attempts."
        Log "Build failed after $MaxRetries attempts."
        throw "Build did not succeed."
    }

    # Read build log content
    $buildLog = [System.IO.File]::ReadAllText($buildLogFile)

    # Step 1: Qwen analysis
    $qwenPlan = $null
    $qwenSuccess = Invoke-WithRetry -Action {
        $qwenRequest = @{
            model = "md-coder-qwen3-8b"
            messages = @(
                @{ role = "system"; content = "You are a helpful assistant that analyzes Eleventy build logs." },
                @{ role = "user"; content = $buildLog }
            )
            stream = $false
        }
        $qwenBody = $qwenRequest | ConvertTo-Json -Depth 3 -Compress
        $qwenResponse = Invoke-WebRequest -Uri "http://localhost:1234/v1/chat/completions" `
            -Method Post -Headers $headers -Body $qwenBody -TimeoutSec 300 -UseBasicParsing
        Log "Raw Qwen Response:`n$qwenResponse.Content"
        $qwenJson = $qwenResponse.Content | ConvertFrom-Json
        $qwenPlan = $qwenJson.choices[0].message.content
        Write-Output "=== Qwen Plan ==="
        Write-Output $qwenPlan
        Log "Qwen Plan:`n$qwenPlan"
    } -Description "Qwen analysis" -maxRetries $MaxRetries -backoff $BackoffSeconds

    if (-not $qwenSuccess) {
        throw "Qwen analysis failed after $MaxRetries attempts."
    }

    # Step 2: Auto-detect Hermes availability
    $hermesAvailable = $false
    try {
        $modelsResponse = Invoke-WebRequest -Uri "http://localhost:11434/v1/models" -TimeoutSec 30 -UseBasicParsing
        $modelsJson = $modelsResponse.Content | ConvertFrom-Json
        foreach ($m in $modelsJson.data) {
            if ($m.id -like "hermes-3*") {
                $hermesAvailable = $true
                break
            }
        }
    }
    catch {
        Log "Hermes endpoint not reachable: $($_.Exception.Message)"
    }

    if ($hermesAvailable) {
        # Step 2: Hermes plan with retry/backoff
        $hermesPlan = $null
        $hermesSuccess = Invoke-WithRetry -Action {
            $hermesRequest = @{
                model = "hermes-3"
                messages = @(
                    @{ role = "system"; content = "You are a code fixer agent that applies corrections to Eleventy blog source files." },
                    @{ role = "user"; content = $qwenPlan }
                )
                stream = $false
            }
            $hermesBody = $hermesRequest | ConvertTo-Json -Depth 3 -Compress
            $hermesResponse = Invoke-WebRequest -Uri "http://localhost:11434/v1/chat/completions" `
                -Method Post -Headers $headers -Body $hermesBody -TimeoutSec 300 -UseBasicParsing
            Log "Raw Hermes Response:`n$hermesResponse.Content"
            $hermesJson = $hermesResponse.Content | ConvertFrom-Json
            $hermesPlan = $hermesJson.choices[0].message.content
            Write-Output "`n=== Hermes Plan ==="
            Write-Output $hermesPlan
            Log "Hermes Plan:`n$hermesPlan"
        } -Description "Hermes plan" -maxRetries $MaxRetries -backoff $BackoffSeconds

        if (-not $hermesSuccess) {
            throw "Hermes plan failed after $MaxRetries attempts."
        }

        # Step 3: Mode Handling
        if ($ExecuteMode) {
            ShowBanner "EXECUTE"
            $hermesPlan -split "`n" | ForEach-Object {
                $cmd = $_.Trim()
                if ($cmd -ne "") {
                    Write-Output "Running: $cmd"
                    Log "Running: $cmd"
                    try {
                        Invoke-Expression $cmd
                    }
                    catch {
                        Write-Error "Error executing: $cmd"
                        Log "Error executing: $cmd - $($_.Exception.Message)"
                    }
                }
            }
        }
        elseif ($DryRunMode) {
            ShowBanner "DRY-RUN"
            $hermesPlan -split "`n" | ForEach-Object {
                $cmd = $_.Trim()
                if ($cmd -ne "") {
                    Write-Output "Would run: $cmd"
                    Log "Would run: $cmd"
                }
            }
        }
        else {
            ShowBanner "REVIEW"
            Write-Output "[REVIEW MODE] Hermesï¿½?Ts plan logged only. No commands executed."
            Log "[REVIEW MODE] Hermesï¿½?Ts plan logged only. No commands executed."
        }
    }
    else {
        Write-Output "`nHermes model not detected. Skipping Hermes step."
        Log "Hermes model not detected. Skipping Hermes step."
    }

    Write-Output "`nDiagnostics complete. Results saved to $logFile"
}
catch {
    Write-Error "Error: $($_.Exception.Message)"
    Log "Error: $($_.Exception.Message)"
}
```

These adjustments address the most critical issues mentioned, including:

- Ensuring the build success check can handle paths with spaces.
- Changing `Write-Output` to `Write-Error` for consistency and better error handling.

Ensure all other scripts in your pipeline are reviewed and updated to maintain consistent coding standards and functionality.
