}

Write-Output "Summary entries added to $csvFile"

# Retention policy: keep only the most recent N logs
$allLogs = Get-ChildItem -Path $LogDir -Filter "hermes-*.log" | Sort-Object LastWriteTime -Descending
if ($allLogs.Count -gt $MaxLogs) {
    $logsToDelete = $allLogs[$MaxLogs..($allLogs.Count - 1)]
    foreach ($log in $logsToDelete) {
        Remove-Item $log.FullName -Force
    }
    Write-Output "Old Hermes logs cleaned up. Retained $MaxLogs most recent logs."
}

# Filtered summary view
$csvFiltered = Join-Path $LogDir "hermes-summary-latest.csv"
Import-Csv $csvFile | Sort-Object Timestamp -Descending | Select-Object -First $LastRuns |
