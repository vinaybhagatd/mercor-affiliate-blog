"@"

    # Per-script log file
    $logFile = Join-Path $LogDir "hermes-$($file.BaseName)-$timestamp.log"

    # Send to Hermes
    $response = Send-OllamaRequest -Prompt $issuesPrompt
    $response | Out-File -FilePath $logFile -Encoding UTF8

