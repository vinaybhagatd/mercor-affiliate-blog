<# 
.SYNOPSIS
Generates blogData JSON files for all 11 categories using the universal template.
#>

$categories = @(
    "creative","data","engineering","finance","language",
    "law","medicine","misc","operations","sciences","tech"
)

$template = @{
    layout = "post.njk"
    title = "<SEO title>"
    description = "<SEO-friendly summary>"
    canonical = "/posts/<slug>/"
    og_title = "<SEO title>"
    og_description = "<SEO description>"
    og_image = "/assets/images/thumbnails/<category>.png"
    twitter_title = "<SEO title>"
    twitter_description = "<SEO description>"
    twitter_image = "/assets/images/thumbnails/<category>.png"
    date = "<valid ISO date>"
    tags = @("<category>")
    thumbnail = "<category>.png"
    permalink = "posts/<slug>/index.html"
    analytics = "GA4"
    sections = @{
        persona_context = "Describe the professional in this category, their challenges, and aspirations."
        salary_range = @{
            entry_level = ""
            mid_level = ""
            senior_level = ""
        }
        growth_path = "Explain career trajectory, challenges, and actionable takeaways."
        day_in_life = "Highlight workflows, meetings, and productivity strategies."
        tools_used = @(
            "Top <category> Productivity Tool",
            "Best Remote Collaboration Platform",
            "Essential <category> Learning Resource"
        )
        skills_required = @("Skill 1","Skill 2","Skill 3")
        lead_magnet_cta = "Download our Free <category> Career Guide: Enter your email → Get the Guide"
        recommended_resources = @("Affiliate Resource 1","Affiliate Resource 2")
        disclosure = "Some of the links in this post are affiliate links. If you click and purchase, we may earn a commission at no extra cost to you. We only recommend products we trust and use ourselves."
    }
}

# Output folder
$outFolder = ".\BlogData"
if (-not (Test-Path $outFolder)) { New-Item -ItemType Directory -Path $outFolder }

foreach ($cat in $categories) {

    $json = $template | ConvertTo-Json -Depth 10
    $json = $json.Replace("<category>", $cat)

    $filePath = Join-Path $outFolder "$cat.json"
    $json | Out-File $filePath -Encoding UTF8

    Write-Host "✅ Created: $filePath"
}
